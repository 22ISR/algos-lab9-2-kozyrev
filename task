import tkinter as tk
import math
root = tk.Tk()
root.title("Калькулятор")
root.geometry("800x500")
buttonFrame = tk.Frame(root)
buttonFrame.columnconfigure(0, weight=1)
buttonFrame.columnconfigure(1, weight=1)
buttonFrame.columnconfigure(2, weight=1)
buttonFrame.columnconfigure(3, weight=1)

def on_button_click(value):
    if value == "=":
        try:
            result = eval(textbox.get("1.0", tk.END))
            textbox.delete("1.0", tk.END)
            textbox.insert( tk.END, result)
        except ZeroDivisionError:            
            textbox.delete("1.0", tk.END)
            textbox.insert( tk.END, "Деление на ноль")
        except:          
            textbox.delete("1.0", tk.END)
            textbox.insert( tk.END, "Ошибка")
    elif value == "√":
        result = math.sqrt(int(eval(textbox.get("1.0", tk.END))))
        textbox.delete("1.0", tk.END)
        textbox.insert(tk.END, result)
    elif value == "Clear":
        textbox.delete("1.0", tk.END)
    elif value == "sickle_and_hummer":
            textbox.delete("1.0", tk.END)
            textbox.insert(tk.END, "Вычисления показали, что сейчас время захватить средства производства >:)")
    else:
        textbox.insert(tk.END, value)



label = tk.Label(root, text="Калькулятор", font=("Arial", 18))
label.pack(padx=20, pady=20)

textbox = tk.Text(root, height=3, font=("Arial", 16))
textbox.pack(padx=0, pady=0)

btn1 = tk.Button(buttonFrame, text="1", font=("Arial", 18), command=lambda v=1: on_button_click(v))
btn2 = tk.Button(buttonFrame, text="2", font=("Arial", 18), command=lambda v=2: on_button_click(v))
btn3 = tk.Button(buttonFrame, text="3", font=("Arial", 18), command=lambda v=3: on_button_click(v))
btn_minus = tk.Button(buttonFrame, text="-", font=("Arial", 18), command=lambda v='-': on_button_click(v))

btn1.grid(row=1, column=0, sticky="we")
btn2.grid(row=1, column=1, sticky="we")
btn3.grid(row=1, column=2, sticky="we")
btn_minus.grid(row=1, column=3, sticky="we")

btn4 = tk.Button(buttonFrame, text="4", font=("Arial", 18), command=lambda v=4: on_button_click(v))
btn5 = tk.Button(buttonFrame, text="5", font=("Arial", 18), command=lambda v=5: on_button_click(v))
btn6 = tk.Button(buttonFrame, text="6", font=("Arial", 18), command=lambda v=6: on_button_click(v))
btn_plus = tk.Button(buttonFrame, text="+", font=("Arial", 18), command=lambda v='+': on_button_click(v))

btn4.grid(row=2, column=0, sticky="we")
btn5.grid(row=2, column=1, sticky="we")
btn6.grid(row=2, column=2, sticky="we")
btn_plus.grid(row=2, column=3, sticky="we")

btn7 = tk.Button(buttonFrame, text="7", font=("Arial", 18), command=lambda v=7: on_button_click(v))
btn8 = tk.Button(buttonFrame, text="8", font=("Arial", 18), command=lambda v=8: on_button_click(v))
btn9 = tk.Button(buttonFrame, text="9", font=("Arial", 18), command=lambda v=9: on_button_click(v))
btn_umn = tk.Button(buttonFrame, text="*", font=("Arial", 18), command=lambda v='*': on_button_click(v))

btn7.grid(row=3, column=0, sticky="we")
btn8.grid(row=3, column=1, sticky="we")
btn9.grid(row=3, column=2, sticky="we")
btn_umn.grid(row=3, column=3, sticky="we")

btn_clear = tk.Button(buttonFrame, text="Clear", font=("Arial", 18), command=lambda v='Clear': on_button_click(v))
btn0 = tk.Button(buttonFrame, text="0", font=("Arial", 18), command=lambda v=0: on_button_click(v))
btn_answ = tk.Button(buttonFrame, text="=", font=("Arial", 18), command=lambda v='=': on_button_click(v))
btn_del = tk.Button(buttonFrame, text="/", font=("Arial", 18), command=lambda v='/': on_button_click(v))

btn_clear.grid(row=4, column=0, sticky="we")
btn0.grid(row=4, column=1, sticky="we")
btn_answ.grid(row=4, column=2, sticky="we")
btn_del.grid(row=4, column=3, sticky="we")

btn_radical = tk.Button(buttonFrame, text="√", font=("Arial", 18), command=lambda v='√': on_button_click(v))
btn_open = tk.Button(buttonFrame, text="(", font=("Arial", 18), command=lambda v='(': on_button_click(v))
btn_close = tk.Button(buttonFrame, text=")", font=("Arial", 18), command=lambda v=')': on_button_click(v))

btn_radical.grid(row=0, column=0, sticky="we")
btn_open.grid(row=0, column=1, sticky="we")
btn_close.grid(row=0, column=2, sticky="we")
# textbox.insert(tk.END, "Введите pin-код")

btn_meme = tk.Button(buttonFrame, text="☭", font=("Arial", 18), command=lambda v='sickle_and_hummer': on_button_click(v))
btn_meme.grid(row=0, column=3, sticky="we")

buttonFrame.pack(fill="x")
root.mainloop()
